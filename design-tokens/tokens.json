  "radiusPt": {
    "xs": 6,
    "sm": 10,
    "md": 14,
    "lg": 20,
    "xl": 28,
    "pill": 9999
  },
  "minMobileTouchTargetPt": 44,
  "motion": {
    "fastMs": 150,
    "normalMs": 260,
    "slowMs": 420,
    "spring": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "material": {
    "content": "standard-opaque-or-system-material",
    "navigation": "system-liquid-glass-regular-where-supported",
    "mediaOverlay": "glass-clear-only-when-contrast-permits",
    "fallback": "opaque-semantic-color",
    "never": "full-screen-permanent-backdrop-blur"
  },
  "accessibility": {
    "reduceTransparency": "force-opaque-fallback",
    "reduceMotion": "disable-spring-and-morph",
    "highContrast": "increase-boundary-and-text-contrast",
    "iconOnly": "requires-accessibility-label"
  },
  "mapping": {
    "macOS": "SwiftUI dynamic Color/Material, squircle continuous corners, and system native controls",
    "web": "CSS variables with color-scheme, backdrop-filter, prefers-reduced-motion",
    "android": "Flutter ThemeExtension on Material app"
  }
